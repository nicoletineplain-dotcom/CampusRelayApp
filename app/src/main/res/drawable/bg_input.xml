<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">

            <solid android:color="@color/campus_green_deep" />

            <stroke
                android:width="1dp"
                android:color="@color/campus_mint" />

            <corners android:radius="12dp" />

            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="4dp"
                android:bottom="4dp" />

        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">

            <solid android:color="@color/campus_green_deep" />

            <stroke
                android:width="1dp"
                android:color="@color/surface_border" />

            <corners android:radius="12dp" />

            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="4dp"
                android:bottom="4dp" />

        </shape>
    </item>

</selector>