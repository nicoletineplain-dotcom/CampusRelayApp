<?xml version="1.0" encoding="utf-8"?>

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">

        <shape>

            <solid
                android:color="@color/surface_green" />

            <stroke
                android:width="1dp"
                android:color="@color/campus_mint" />

            <corners
                android:radius="12dp" />

        </shape>

    </item>


    <item>

        <shape>

            <solid
                android:color="@android:color/transparent" />

            <stroke
                android:width="1dp"
                android:color="@color/campus_mint" />

            <corners
                android:radius="12dp" />

        </shape>

    </item>

</selector>